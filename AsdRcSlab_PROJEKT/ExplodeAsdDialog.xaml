<Window x:Class="AsdRcSlab.ExplodeAsdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explode ASD Objects"
        Width="640" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="EXPLODE ASD OBJECTS" FontSize="13" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="3"
                Padding="8,5" Margin="0,0,0,8">
            <TextBlock x:Name="TxtInfo" FontSize="12" Foreground="#1565C0"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Lista warstw ASD z licznikami + checkboxy -->
        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA"
                  FontSize="11">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ASD Layer" Binding="{Binding LayerName}"
                                    Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Objects" Binding="{Binding Count}"
                                    Width="90" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Opcje -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Select all" Width="90" Height="26" Margin="0,0,8,0"
                    Click="BtnSelectAll_Click"
                    Background="#ECEFF1" BorderThickness="1" BorderBrush="#B0BEC5"/>
            <Button Content="Select none" Width="90" Height="26" Margin="0,0,16,0"
                    Click="BtnSelectNone_Click"
                    Background="#ECEFF1" BorderThickness="1" BorderBrush="#B0BEC5"/>
            <CheckBox x:Name="ChkRecursive" Content="Explode recursively (RBCR/RBCT)"
                      IsChecked="True" VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>

        <!-- Przyciski -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Explode" Width="120" Height="28" Margin="0,0,8,0"
                    Click="BtnExplode_Click"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="80" Height="28"
                    Click="BtnCancel_Click"
                    Background="#757575" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
