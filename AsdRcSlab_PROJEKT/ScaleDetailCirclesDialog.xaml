<Window x:Class="AsdRcSlab.ScaleDetailCirclesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scale Detail Circles (1:25)"
        Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="SCALE DETAIL CIRCLES (1:25)" FontSize="13" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="3"
                Padding="8,5" Margin="0,0,0,8">
            <TextBlock x:Name="TxtInfo" FontSize="12" Foreground="#1565C0"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       Text="Scales distribution circles (×0.5) inside checked 1:25 detail frames. Unchecked rows marked '(check!)' need verification."/>
        </Border>

        <DataGrid Grid.Row="2" x:Name="Grid" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" RowHeaderWidth="0"
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA"
                  FontSize="11">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="36">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}"
                                    Width="*" MinWidth="180" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Detail}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Scale"   Binding="{Binding Scale}"   Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Circles" Binding="{Binding Circles}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Center"  Binding="{Binding Center}"  Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size"    Binding="{Binding Size}"    Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Dist"    Binding="{Binding Dist}"    Width="110" IsReadOnly="True">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Uncertain}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#B71C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Select all" Width="90" Height="26" Margin="0,0,8,0"
                    Click="BtnSelectAll_Click"
                    Background="#ECEFF1" BorderThickness="1" BorderBrush="#B0BEC5"/>
            <Button Content="Select none" Width="90" Height="26"
                    Click="BtnSelectNone_Click"
                    Background="#ECEFF1" BorderThickness="1" BorderBrush="#B0BEC5"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Apply" Width="120" Height="28" Margin="0,0,8,0"
                    Click="BtnApply_Click"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="80" Height="28"
                    Click="BtnCancel_Click"
                    Background="#757575" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
