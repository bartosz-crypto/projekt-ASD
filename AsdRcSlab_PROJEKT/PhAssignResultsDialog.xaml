<Window x:Class="AsdRcSlab.PhAssignResultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Assign PH — Results"
        Width="780" Height="530"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <x:Array x:Key="PhOptions" Type="{x:Type sys:String}">
            <sys:String>PH1</sys:String>
            <sys:String>PH2</sys:String>
            <sys:String>PH3</sys:String>
            <sys:String>PH4</sys:String>
            <sys:String>PH5</sys:String>
            <sys:String>PH6</sys:String>
            <sys:String>PH7</sys:String>
            <sys:String>PH8</sys:String>
            <sys:String>PH9</sys:String>
            <sys:String>MANUAL</sys:String>
            <sys:String>NO ACTION</sys:String>
        </x:Array>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,10">
            <TextBlock Text="ASSIGN PH — WYNIKI" FontSize="13" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- Statystyki: liczby per PH -->
        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="3"
                Padding="8,5" Margin="0,0,0,4">
            <TextBlock x:Name="TxtStats" FontSize="12" Foreground="#1565C0"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>

        <!-- Formuły H12/H16 — wyraźny bold pod statystykami -->
        <TextBlock Grid.Row="2" x:Name="TxtTotals"
                   FontSize="14" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="#0D47A1"
                   Margin="0,4,0,10"
                   Text=""/>

        <!-- Tabela — IsReadOnly ustawiane programowo w konstruktorze -->
        <DataGrid Grid.Row="3" x:Name="Grid" AutoGenerateColumns="False"
                  CellEditEnding="Grid_CellEditEnding"
                  LoadingRow="Grid_LoadingRow"
                  RowHeaderWidth="0"
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA"
                  FontSize="11">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pile ID"      Binding="{Binding PileId}"       Width="70"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Util %"       Binding="{Binding UtilPctStr}"   Width="60"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Location"     Binding="{Binding LocationType}" Width="80"  IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="PH Action"
                                        SelectedItemBinding="{Binding PhAction, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{StaticResource PhOptions}"
                                        Width="100"/>
                <DataGridTextColumn Header="Detail Title" Binding="{Binding DetailTitle}"  Width="*"   IsReadOnly="True"/>
            </DataGrid.Columns>
            <!-- p165: kolory wierszy ustawiane WYŁĄCZNIE w Grid_LoadingRow (code-behind).
                 DataTriggery w RowStyle nie działały: DataGrid koerceje Background wiersza
                 z AlternatingRowBackground, co nadpisuje wartości ze Style Triggers
                 (co drugi wiersz tracił kolor), a PH2-PH6 w ogóle nie miały triggera. -->
        </DataGrid>

        <!-- Przyciski -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Export to Excel" Width="130" Height="28" Margin="0,0,8,0"
                    Click="BtnExport_Click"
                    Background="#2E7D32" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnUpdateDrawing" Content="Update Drawing"
                    Visibility="Collapsed"
                    Width="140" Height="28" Margin="0,0,8,0"
                    Click="BtnUpdateDrawing_Click"
                    Background="#1565C0" Foreground="White" BorderThickness="0"/>
            <Button Content="Close" IsCancel="True" Width="80" Height="28"
                    Background="#757575" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
