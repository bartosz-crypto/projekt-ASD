<Window x:Class="AsdRcSlab.ImrPlotPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select reinforcement map plot" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Found plots in source file:" Margin="0,0,0,6"
                   FontWeight="SemiBold"/>

        <ListBox x:Name="PlotList" Grid.Row="1" Margin="0,0,0,10"
                 MouseDoubleClick="PlotList_DoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Height="28" Margin="0,0,8,0"
                    Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="28"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
